          "preamble": {
            "js": "// Keep the authored part ID even when Explore gives a visited part a button label or a new path.\nfunction definitionId(part) {\n    return part.json?.customName || part.xml?.getAttribute('customname') || part.xml?.getAttribute('customName');\n}\n\n// The host can consume these independent submissions without treating an optional part as progress.\n// The exam does not write to Classroom's recognition or persistent history.\nquestion.classroomAttempts = [];\nquestion.events.on('addExtraPart', function (part) {\n    const id = definitionId(part);\n    const parent = part.previousPart;\n    const fromWrong = Boolean(parent && part.getScope().getVariable('from_wrong').value);\n    let newSelection = false;\n    let lastChoice = -1;\n\n    // Let an embedding host submit first when it already implements immediate marking.\n    part.events.on('storeAnswer', function () {\n        if (!part.stagedAnswer?.some(row => row[0]) || part.resuming || question.exam.loading) return;\n        newSelection = true;\n        queueMicrotask(function () {\n            if (part.isDirty && !part.locked && !part.submitting) part.submit();\n        });\n    });\n\n    if (fromWrong) {\n        part.display?.html_promise.then(function () { part.openSteps(); });\n    }\n\n    part.events.on('post-submit', function () {\n        if (!part.answered || part.resuming || question.exam.loading || question.exam.mode === 'review') return;\n        const choice = part.ticks.findIndex(row => row[0]);\n        if (choice < 0 || (!newSelection && choice === lastChoice)) return;\n        newSelection = false;\n        lastChoice = choice;\n        const correct = part.score === part.marks;\n        question.classroomAttempts.push({\n            lessonId: 'm1-l009', questionId: id, parentId: parent ? definitionId(parent) : null,\n            role: parent ? 'supplement' : 'main', route: parent ? (fromWrong ? 'wrong' : 'optional') : 'main',\n            choiceIndex: choice, kind: correct ? 'correct' : 'wrong',\n            score: part.score, maximum: part.marks, at: new Date().toISOString()\n        });\n\n        // Mirror the authored Numbas feedback in the prompt so the embedded theme exposes it.\n        part.display?.html_promise.then(function (section) {\n            const output = section.querySelector('[data-classroom-result]');\n            if (output) output.innerHTML = part.settings.distractors[choice][0];\n        });\n    });\n});\n\n// The embedded theme has a native question menu, but omits its return button.\nquestion.signals.on('HTMLAttached', function () {\n    question.display.html_promise.then(function (article) {\n        const back = article.querySelector('[data-classroom-menu]');\n        if (back) back.addEventListener('click', function () { question.exam.showMenu(); });\n    });\n});\n",
