          "parts": [
            {
              "type": "1_n_2",
              "useCustomName": true,
              "customName": "m1-l009-M1",
              "prompt": "<p>（−2）＋（＋4）を数直線の上に2本の矢印で表します。1本目は0から−2まで引きました。続けて引く2本目の矢印はどれですか。</p><p><span data-classroom-result=\"yes\" role=\"status\" aria-live=\"polite\"></span></p>",
              "marks": 1,
              "choices": [
                "0 → ＋4",
                "−2 → ＋2",
                "−2 → ＋1",
                "−2 → −6"
              ],
              "matrix": [
                0,
