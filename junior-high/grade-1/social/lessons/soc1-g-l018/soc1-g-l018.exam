                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「速い食事」への反省から生まれた、「ゆっくりと食事や食文化を大切にする」運動でした。</p>"
                }
              ],
