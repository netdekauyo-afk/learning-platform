              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>資料から読み取れる内容として、ヒンドゥー教が広く信仰され、IT産業が発展している地域はどれですか。</p>",
              "minMarks": 0,
