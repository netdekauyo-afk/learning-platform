                  "variableReplacementStrategy": "originalfirst",
                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：南アジアの人々の生活と結びついた宗教で、ガンジス川を聖なる川とする信仰を思い出しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>南アジアのインドを中心に広く信仰されている宗教はどれですか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
