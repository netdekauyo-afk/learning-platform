                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「距」は距離、「方位」は方角を表す言葉です。図法の名前そのものに特色が表れています。</p>"
                }
              ],
              "scripts": {},
