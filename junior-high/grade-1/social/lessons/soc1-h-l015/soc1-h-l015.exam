                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：稲作によって、人々の暮らしにどのような新しい問題が生まれたかを考えましょう。</p>"
