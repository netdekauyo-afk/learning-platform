                  "prompt": "<p>ヒント：国風文化の作品には、かな文字が使われました。大陸との関係がどう変わったかに注目しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
