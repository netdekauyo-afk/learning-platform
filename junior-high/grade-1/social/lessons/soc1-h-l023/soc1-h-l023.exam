                  "prompt": "<p>ヒント：天皇が幼いときと成人した後とで、補佐する役職の名前が変わりました。その使い分けがポイントです。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
