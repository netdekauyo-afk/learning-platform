                  "type": "information",
                  "useCustomName": false,
                  "customName": "",
                  "marks": 0,
                  "showCorrectAnswer": true,
                  "showFeedbackIcon": true,
                  "scripts": {},
                  "variableReplacements": [],
                  "variableReplacementStrategy": "originalfirst",
                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：多くの人々を養う都市や国家が生まれるには、何が欠かせなかったかを考えましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>四大文明がいずれも大河の流域に起こった理由として、最も適切なものはどれですか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
