        {
          "name": "元寇（モンゴルの襲来）と鎌倉幕府の衰退（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "歴史",
