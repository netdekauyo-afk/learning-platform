                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：細川氏・斯波氏・畠山氏が交代で就いた役職です。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>室町幕府で、将軍を補佐する最高の役職として置かれたものはどれですか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
