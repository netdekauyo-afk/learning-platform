              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>観光地の自然や町並みを守るために行われている工夫として、適切なものはどれですか。</p>",
              "minMarks": 0,
