                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「特色」の列と「主な資源・産業」の列を、同じ行で見比べてみましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
