                  "variableReplacementStrategy": "originalfirst",
                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：石碑に実際に刻まれていることと、生徒が考えたことを区別して読みましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>このメモの中で、「推測」にあたる部分はどれですか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
              "displayType": "radiogroup",
              "displayColumns": 1,
              "showCellAnswerState": true,
              "choices": [
                "「当時の村人たちが豊作を願って建てたのだろう」という部分",
                "石碑に「天保3年」と刻まれているという部分",
                "石碑が神社の入口のそばにあるという部分",
                "天保3年が1832年であるという部分"
              ],
              "matrix": [
                1,
                0,
                0,
                0
              ],
              "distractors": [
                "",
                "刻まれている文字は目で確認できる事実であり、推測ではないという点の取り違え。",
                "場所は現地で確認できる事実である。推測は「なぜ建てられたか」という理由の部分にある。",
                "年号の換算は確かめられる事実である。考えの部分と事実の部分を区別できていない。"
              ]
            }
