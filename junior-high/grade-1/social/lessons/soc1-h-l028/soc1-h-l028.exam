                  "unitTests": [],
                  "prompt": "<p>ヒント：資料に書かれていることと、自分の考えは、同じものとして書いてよいでしょうか。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>調査の記録における「事実」と「推測」の扱いとして、正しいものはどれですか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
