                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：左京と右京が、それぞれ大路のどちら側にあるかを確認しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
