              "displayColumns": 1,
              "showCellAnswerState": true,
              "choices": [
                "東市は左京に、西市は右京に置かれていた",
                "平城宮は、都の南側に置かれていた",
                "朱雀大路は、都を東西に通る通りであった",
                "市場は、平城宮の中に設けられていた"
              ],
              "matrix": [
