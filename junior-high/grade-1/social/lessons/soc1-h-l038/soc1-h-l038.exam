                  "unitTests": [],
                  "prompt": "<p>ヒント：当時の人々にとって、教えが「実践しやすいかどうか」に注目しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
