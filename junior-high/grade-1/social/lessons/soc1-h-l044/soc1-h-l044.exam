                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：惣村の自治は「やらされた」ものか「自分たちで始めた」ものか、そしてその背景に産業の発達があったかを考えましょう。</p>"
                }
              ],
              "scripts": {},
