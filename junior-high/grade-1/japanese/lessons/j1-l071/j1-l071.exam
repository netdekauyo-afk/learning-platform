                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「稲作」と「踏切」は訓読みをふくむ言葉、「鉄塔」は音読みの熟語です。小さい「っ」が入るかどうかにも気をつけましょう。</p>"
                }
              ],
              "scripts": {},
