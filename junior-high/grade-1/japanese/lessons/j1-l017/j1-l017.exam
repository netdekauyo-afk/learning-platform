                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：説明文は、筆者が読み手に何を伝えようとして書いた文章か、という視点で考えてみましょう。</p>"
                }
              ],
              "scripts": {},
