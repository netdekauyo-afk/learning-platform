                  "unitTests": [],
                  "prompt": "<p>ヒント：作品に出てくる戦時下の語句（疎開・配給・空襲など）が、どの時代を指すかを考えてみましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
