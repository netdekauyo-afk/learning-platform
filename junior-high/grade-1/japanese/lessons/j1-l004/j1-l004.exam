                  "unitTests": [],
                  "prompt": "<p>ヒント：ノートは授業のあとも見返して使うものです。あとから書き足す場面を思い浮かべてみましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
