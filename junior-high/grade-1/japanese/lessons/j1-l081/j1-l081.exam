                  "unitTests": [],
                  "prompt": "<p>ヒント：筆者が「不便」に対して、従来とは違うどんな評価を与えているかに注目しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
