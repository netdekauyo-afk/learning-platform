                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：たとえは、相手の頭の中にイメージを共有させるためのものです。相手が知らないものでは共有できません。</p>"
                }
              ],
              "scripts": {},
