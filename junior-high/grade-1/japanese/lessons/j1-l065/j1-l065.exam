                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「摘む」は送り仮名に注目しましょう。ほかの2つは音読みの熟語です。1つでも間違えている組み合わせは選べません。</p>"
                }
              ],
              "scripts": {},
