                  "unitTests": [],
                  "prompt": "<p>ヒント：この小説では、登場人物どうしの関係と、その変化を押さえることが読み取りの土台でした。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
