                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「殿様」は音読みではなく訓読みで読む言葉です。ほかの2つは音読みの熟語で、濁るかどうかにも気をつけましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
