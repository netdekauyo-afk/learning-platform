                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：レポートの説得力は、事実と自分の考えのつながりから生まれます。構成案の段階で、何と何を結びつけておくか考えてみましょう。</p>"
                }
              ],
