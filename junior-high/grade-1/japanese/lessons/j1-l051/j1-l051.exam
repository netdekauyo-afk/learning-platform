                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：忙しい読み手でも、必要な情報をすぐに見つけられる形はどんな形かを考えてみましょう。</p>"
                }
              ],
              "scripts": {},
