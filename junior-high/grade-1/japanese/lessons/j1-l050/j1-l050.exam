                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：案内文は、読み手が行動するために読む実用的な文章です。どんな情報がそろっていれば読み手が困らないかを考えてみましょう。</p>"
                }
              ],
