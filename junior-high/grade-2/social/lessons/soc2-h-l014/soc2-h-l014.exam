                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：農具ごとに役割が違います。「脱穀」という作業に結びつくものを選びましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>稲の脱穀（実を茎から外す作業）の能率を大幅に上げた農具はどれですか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
