                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：近世の始まりは、戦国の世を終わらせた全国統一の時代でしたね。</p>"
                }
              ],
              "scripts": {},
