        {
          "name": "中国・四国地方のまとめ活動（交通・通信を中核とした考察）（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
