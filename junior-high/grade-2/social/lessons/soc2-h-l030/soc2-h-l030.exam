              "displayColumns": 1,
              "showCellAnswerState": true,
              "choices": [
                "下田・函館",
                "横浜・長崎",
                "新潟・兵庫",
                "大阪・神戸"
              ],
              "matrix": [
                1,
                0,
                0,
                0
              ],
              "distractors": [
                "",
                "横浜と長崎は、1858年の日米修好通商条約で貿易のために開かれた港です。和親条約ではありません。",
                "新潟と兵庫も1858年の通商条約の開港地です。和親条約の2港ではありません。",
                "大阪は開港地ではなく、神戸は兵庫港ののちの名称です。和親条約で開かれた港ではありません。"
              ]
            }
          ],
