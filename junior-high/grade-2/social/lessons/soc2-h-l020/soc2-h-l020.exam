              "showCellAnswerState": true,
              "choices": [
                "株仲間の解散で物価がかえって混乱し、上知令には大名や旗本が強く反発するなど、社会の反発を招いたから",
                "大塩平八郎の乱によって水野忠邦が倒され、改革が続けられなくなったから",
                "外国との戦争に敗れ、幕府が多額の賠償金を払うことになったから",
                "徳川吉宗が改革のやり直しを命じ、忠邦を退けたから"
              ],
              "matrix": [
                1,
                0,
                0,
                0
              ],
              "distractors": [
