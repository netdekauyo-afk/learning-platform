              "showFeedbackIcon": true,
              "stepsPenalty": 0,
              "steps": [
                {
                  "type": "information",
                  "useCustomName": false,
                  "customName": "",
                  "marks": 0,
                  "showCorrectAnswer": true,
                  "showFeedbackIcon": true,
                  "scripts": {},
