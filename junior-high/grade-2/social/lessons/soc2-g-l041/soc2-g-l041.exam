                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「大都市の近郊」で行われる農業です。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>東京などの大都市の近くで、新鮮な野菜や花を栽培して短時間で市場へ出荷する農業を何といいますか。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
              "displayType": "radiogroup",
              "displayColumns": 1,
              "showCellAnswerState": true,
              "choices": [
                "近郊農業",
                "施設園芸農業",
                "高冷地農業",
                "促成栽培"
              ],
              "matrix": [
                1,
                0,
                0,
                0
              ],
              "distractors": [
                "",
                "施設園芸農業は、ビニールハウスなどの施設を使う農業の形態を指す言葉です。大都市に近い立地を生かす農業を指す言葉ではありません。",
                "高冷地農業は、標高の高い涼しい地域で行われる農業です。中央高地などで見られます。",
                "促成栽培は、温暖な地域で出荷時期を早める栽培方法です。立地を表す言葉ではありません。"
              ]
            }
