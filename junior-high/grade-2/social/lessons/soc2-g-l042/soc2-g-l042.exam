              "displayColumns": 1,
              "showCellAnswerState": true,
              "choices": [
                "高速道路網が整備され、大消費地や港への輸送が便利になったから",
                "海に面していて、大型船で原料を運び込めるから",
                "石炭などの原料が、地域内で豊富にとれるから",
                "都心よりも人口が多く、働く人が集まりやすいから"
              ],
              "matrix": [
                1,
                0,
                0,
                0
              ],
              "distractors": [
                "",
