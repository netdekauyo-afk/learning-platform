                  "unitTests": [],
                  "prompt": "<p>ヒント：瀬戸内地域の降水量が少ないのはなぜだったか、山地の位置と関係づけて考えてみましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
