              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>関東平野の台地を覆っている、周辺の火山の噴火による火山灰が積もってできた赤土の地層を何といいますか。</p>",
              "minMarks": 0,
