                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「商業への姿勢」と「代表的な政策」の行を、2人の列で比べてみましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
