                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：鹿児島県や宮崎県に広がる、火山灰の台地の名前を思い出しましょう。</p>"
                }
              ],
              "scripts": {},
