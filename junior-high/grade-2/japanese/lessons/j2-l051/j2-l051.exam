                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：推敲では、正しいかどうかだけでなく、受け取った相手がどう感じるかを想像することがポイントです。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
