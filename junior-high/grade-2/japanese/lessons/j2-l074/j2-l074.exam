                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：単なる印象論にしないためには何が必要だったかを思い出しましょう。「なぜなら本文の〜から」という形が手がかりです。</p>"
                }
              ],
