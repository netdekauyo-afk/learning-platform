                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：人物像はセリフ以外の描写からも読み取れます。また、人物を決めつけず、そうなった背景に目を向けることが大切です。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
