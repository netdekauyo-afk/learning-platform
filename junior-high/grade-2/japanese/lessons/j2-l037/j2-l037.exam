                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：速報性・詳細さ・信頼性という三つの観点で、それぞれのメディアの得意な点と不得意な点を思い出しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
