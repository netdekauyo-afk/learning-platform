                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：意見の説得力は、印象ではなく根拠の中身で判断します。事実かどうかと、主張との結び付きに注目しましょう。</p>"
                }
              ],
