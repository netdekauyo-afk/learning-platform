              "maxMarks": 1,
              "shuffleChoices": true,
              "displayType": "radiogroup",
              "displayColumns": 1,
              "showCellAnswerState": true,
              "choices": [
                "下の字が上の字の目的語・補語になる（「山に登る」と下から上へ読む）",
                "似た意味の漢字を重ねる",
                "上の字が下の字を修飾する（「登る山」と上から下へ読む）",
