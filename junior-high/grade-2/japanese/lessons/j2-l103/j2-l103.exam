                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：物語の軸は事件の大きさではなく、主人公の心の動きでした。出発点とゴールを先に決めることもポイントです。</p>"
                }
              ],
              "scripts": {},
