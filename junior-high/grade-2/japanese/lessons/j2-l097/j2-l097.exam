                  "unitTests": [],
                  "prompt": "<p>ヒント：表面的な理由ではなく、二人に共通する「一度だけ心が揺らいだ」という点に注目しましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
