                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：係助詞の種類によって、結びの活用形がどう変わるかが決まりでした。「こそ」の場合を特に思い出しましょう。</p>"
                }
              ],
              "scripts": {},
