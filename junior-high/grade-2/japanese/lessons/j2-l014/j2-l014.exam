                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：作者・時代・ジャンルの三点を、ほかの古典作品と取り違えていないか確かめましょう。冒頭の言い切りの形も手がかりです。</p>"
                }
              ],
              "scripts": {},
