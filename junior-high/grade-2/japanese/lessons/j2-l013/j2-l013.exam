                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：振り返りでは、記憶だけでは気づけない自分の話し方を確認することが大切でした。何が見えるようになるか考えましょう。</p>"
                }
              ],
