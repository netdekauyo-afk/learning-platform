                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：相手の動作を高めるのが尊敬語、自分の動作をへりくだるのが謙譲語です。「誰の動作か」を見極めましょう。また、敬語を重ねすぎる言い方にも注意が必要です。</p>"
                }
              ],
              "scripts": {},
