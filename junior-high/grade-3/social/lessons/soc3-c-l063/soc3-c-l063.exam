        {
          "name": "株式会社の仕組みと株主の権利・投資と配当（資料読解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
