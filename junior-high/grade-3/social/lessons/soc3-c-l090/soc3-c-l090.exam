        {
          "name": "ODA・PKO・NGOなど世界と協力する日本の国際貢献（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
