        {
          "name": "冷戦後の日本の変化（バブル崩壊・少子高齢化・大震災）（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
