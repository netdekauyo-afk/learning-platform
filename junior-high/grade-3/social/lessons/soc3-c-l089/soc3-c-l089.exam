              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>この資料から読み取れる、日本の核軍縮外交の特徴として正しいものを選びなさい。</p>",
              "minMarks": 0,
              "maxMarks": 1,
              "shuffleChoices": true,
