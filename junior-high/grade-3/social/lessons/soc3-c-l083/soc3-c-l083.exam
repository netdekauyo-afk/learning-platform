        {
          "name": "国際連合（国連）の仕組みと総会・安保理・専門機関の役割（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
