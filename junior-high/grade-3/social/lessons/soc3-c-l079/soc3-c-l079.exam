        {
          "name": "SDGsから捉える地球規模の課題（国際社会への導入）（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
