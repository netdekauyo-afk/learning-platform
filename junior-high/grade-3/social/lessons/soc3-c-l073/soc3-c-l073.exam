      "questions": [
        {
          "name": "財政の役割（社会資本・公共サービス・景気調整）と公債（知識）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
