        {
          "name": "戦後日本の歩みの概観（現代史後半への導入）（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "歴史",
