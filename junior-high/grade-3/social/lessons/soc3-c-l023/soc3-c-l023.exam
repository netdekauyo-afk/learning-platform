              "showCellAnswerState": true,
              "choices": [
                "思想・良心の自由、信教の自由、表現の自由、学問の自由",
                "信教の自由、職業選択の自由、財産権、検閲の禁止",
                "表現の自由、令状なしの逮捕の禁止、黙秘権、学問の自由",
                "居住・移転の自由、職業選択の自由、財産権、思想・良心の自由"
              ],
              "matrix": [
                1,
                0,
                0,
                0
              ],
              "distractors": [
                "",
                "職業選択の自由や財産権は「経済活動の自由」に分類されます。",
                "令状なしの逮捕の禁止（令状主義）や黙秘権は「身体の自由」に分類されます。",
                "居住・移転の自由、職業選択の自由、財産権はいずれも「経済活動の自由」に分類されます。"
              ]
            }
          ],
