        {
          "name": "大正デモクラシーと政党内閣の成立（原敬・護憲運動）（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
