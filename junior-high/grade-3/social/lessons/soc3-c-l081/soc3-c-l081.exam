        {
          "name": "日本の領土をめぐる問題（北方領土・竹島・尖閣諸島）の現状（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
