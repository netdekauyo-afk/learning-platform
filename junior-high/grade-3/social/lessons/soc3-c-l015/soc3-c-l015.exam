                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：総数の増加や国籍・地域の数、さらに在留資格の内訳（永住者や働く人・留学生など）の変化に注目しましょう。</p>"
                }
              ],
              "scripts": {},
