      "questions": [
        {
          "name": "世界恐慌の発生と各国の対策（ニューディール・ブロック経済）（知識）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "歴史",
