                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：住民投票（解散・解職を除く）の根拠やテーマの内訳と、解散・解職投票の成立件数を比べてみましょう。</p>"
                }
              ],
              "scripts": {},
