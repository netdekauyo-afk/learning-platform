        {
          "name": "地方自治の考え方（住民自治・団体自治）と役割（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
