        {
          "name": "私たちの生活と文化（科学・宗教・芸術）の役割（資料読解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
