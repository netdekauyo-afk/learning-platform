                  "variableReplacementStrategy": "originalfirst",
                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：開戦から約半年後に、太平洋の中部にある島をめぐって行われた海戦です。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
              "adaptiveMarkingPenalty": 0,
              "customMarkingAlgorithm": "",
              "extendBaseMarkingAlgorithm": true,
              "unitTests": [],
              "prompt": "<p>1942年6月に日本海軍が主力空母を失って大敗し、太平洋戦争の戦局の転換点となった海戦はどれか。</p>",
              "minMarks": 0,
