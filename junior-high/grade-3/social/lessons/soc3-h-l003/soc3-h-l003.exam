        {
          "name": "日露戦争の経緯とポーツマス条約・国際社会への影響（知識）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
