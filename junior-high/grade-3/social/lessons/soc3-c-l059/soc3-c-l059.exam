        {
          "name": "18歳からの契約と多様な支払い方法（クレジット・電子マネー）（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
