        {
          "name": "日本の社会保障制度（社会保険・公的扶助・社会福祉・公衆衛生）（知識）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "公民",
