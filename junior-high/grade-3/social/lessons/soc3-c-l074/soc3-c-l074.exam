                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：給付費の中で「年金」と「医療」を合わせた割合や、財源の中で最も金額が大きい項目を確認しましょう。</p>"
                }
              ],
              "scripts": {},
