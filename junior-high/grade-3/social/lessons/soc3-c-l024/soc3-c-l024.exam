                  "adaptiveMarkingPenalty": 0,
                  "customMarkingAlgorithm": "",
                  "extendBaseMarkingAlgorithm": true,
                  "unitTests": [],
                  "prompt": "<p>ヒント：「労働組合をつくる権利」「使用者と話し合う権利」「ストライキなどを行う権利」の3つです。法律の名称と混同しないようにしましょう。</p>"
                }
              ],
              "scripts": {},
