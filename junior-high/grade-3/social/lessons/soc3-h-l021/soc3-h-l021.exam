        {
          "name": "日中戦争の拡大と国家総動員法・戦時体制（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "歴史",
