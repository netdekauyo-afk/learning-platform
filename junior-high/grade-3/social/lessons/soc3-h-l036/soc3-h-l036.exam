        {
          "name": "冷戦の終結（ベルリンの壁崩壊）と冷戦後の国際社会（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
