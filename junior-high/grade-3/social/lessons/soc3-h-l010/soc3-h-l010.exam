        {
          "name": "第一次世界大戦の勃発と総力戦・日本の参戦（理解）",
          "extensions": [],
          "custom_part_types": [],
          "variable_groups": [],
          "variables": {},
          "ungrouped_variables": [],
          "tags": [
            "歴史",
