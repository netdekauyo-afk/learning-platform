                  "unitTests": [],
                  "prompt": "<p>ヒント：日食は月が太陽を隠す現象です。月の見かけの大きさと太陽の見かけの大きさを比べて考えましょう。</p>"
                }
              ],
              "scripts": {},
              "variableReplacements": [],
              "variableReplacementStrategy": "originalfirst",
